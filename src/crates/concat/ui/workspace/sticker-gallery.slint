import { Theme, Payload } from "../primitives/primitives.slint";
struct StickerData { id: string, name: string, image: image }
export component StickerGrid inherits Rectangle {
    in property <int> category: 1;
    callback placed(id: string, label: string);
    property <[StickerData]> group1: [
        { id: "1f602", name: "Risa", image: @image-url("../../stickers/1f602.png") },
        { id: "1f60d", name: "Enamorado", image: @image-url("../../stickers/1f60d.png") },
        { id: "1f60e", name: "Cool", image: @image-url("../../stickers/1f60e.png") },
        { id: "1f62e", name: "Sorpresa", image: @image-url("../../stickers/1f62e.png") },
        { id: "1f914", name: "Pensando", image: @image-url("../../stickers/1f914.png") },
        { id: "1f92f", name: "Explota la cabeza", image: @image-url("../../stickers/1f92f.png") },
        { id: "1f62d", name: "Llorando", image: @image-url("../../stickers/1f62d.png") },
        { id: "1f973", name: "Fiesta", image: @image-url("../../stickers/1f973.png") },
        { id: "1f525", name: "Fuego", image: @image-url("../../stickers/1f525.png") },
        { id: "1f4af", name: "Cien", image: @image-url("../../stickers/1f4af.png") },
