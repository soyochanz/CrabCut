        { id: "2600", name: I18n.t("stickers.item2600"), image: @image-url("../../stickers/2600.png") },
        { id: "1f334", name: I18n.t("stickers.item1f334"), image: @image-url("../../stickers/1f334.png") },
        { id: "1f30d", name: I18n.t("stickers.item1f30d"), image: @image-url("../../stickers/1f30d.png") },
        { id: "1f355", name: I18n.t("stickers.item1f355"), image: @image-url("../../stickers/1f355.png") },
        { id: "2615", name: I18n.t("stickers.item2615"), image: @image-url("../../stickers/2615.png") },
        { id: "1f389", name: I18n.t("stickers.item1f389"), image: @image-url("../../stickers/1f389.png") },
        { id: "1f3c6", name: I18n.t("stickers.item1f3c6"), image: @image-url("../../stickers/1f3c6.png") },
    ];
    property <[StickerData]> items: root.category == 1 ? root.group1 : root.category == 2 ? root.group2 : root.category == 3 ? root.group3 : root.category == 4 ? root.group4 : root.group5;
    property <int> cols: Math.max(1, Math.floor((root.width + 8px) / 96px));
    property <length> card-w: (root.width - (root.cols - 1) * 8px) / root.cols;
    property <length> card-h: root.card-w + 20px;
    height: Math.ceil(root.items.length / root.cols) * (root.card-h + 8px);
    for item[index] in root.items: Rectangle {
        x: Math.mod(index, root.cols) * (root.card-w + 8px);
        y: Math.floor(index / root.cols) * (root.card-h + 8px);
        width: root.card-w;
        height: root.card-h;
        border-radius: Theme.r;
        background: touch.has-hover ? Theme.field-hover : Theme.field;
        border-width: 1px;
        border-color: touch.has-hover ? Theme.accent : Theme.line;
        drag := DragArea {
            data: Payload.of("sticker:\{item.id}:\{item.name}");
            drag-image: item.image;
            allow-copy: true;
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.placed(item.id, item.name); }
                Image { x: 12px; y: 12px; width: parent.width - 24px; height: root.card-w - 24px; source: item.image; image-fit: contain; }
                Text { x: 4px; y: root.card-w; width: parent.width - 8px; height: 18px; text: item.name; color: Theme.fg-muted; font-size: Theme.fs-sm; horizontal-alignment: center; overflow: elide; }
            }
        }
    }
}
