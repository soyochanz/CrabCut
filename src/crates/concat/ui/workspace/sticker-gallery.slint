        { id: "1f440", name: "Ojos", image: @image-url("../../stickers/1f440.png") },
    ];
    property <[StickerData]> group2: [
        { id: "1f44d", name: "Me gusta", image: @image-url("../../stickers/1f44d.png") },
        { id: "1f44e", name: "No me gusta", image: @image-url("../../stickers/1f44e.png") },
        { id: "1f44c", name: "OK", image: @image-url("../../stickers/1f44c.png") },
        { id: "270c", name: "Victoria", image: @image-url("../../stickers/270c.png") },
        { id: "1f91e", name: "Suerte", image: @image-url("../../stickers/1f91e.png") },
        { id: "1f64c", name: "Celebración", image: @image-url("../../stickers/1f64c.png") },
        { id: "1f64f", name: "Gracias", image: @image-url("../../stickers/1f64f.png") },
        { id: "1f4aa", name: "Fuerza", image: @image-url("../../stickers/1f4aa.png") },
        { id: "1f449", name: "Mira aquí", image: @image-url("../../stickers/1f449.png") },
        { id: "1f446", name: "Arriba", image: @image-url("../../stickers/1f446.png") },
        { id: "1f447", name: "Abajo", image: @image-url("../../stickers/1f447.png") },
        { id: "1f448", name: "Izquierda", image: @image-url("../../stickers/1f448.png") },
    ];
    property <[StickerData]> group3: [
        { id: "2764", name: "Corazón", image: @image-url("../../stickers/2764.png") },
        { id: "1f49b", name: "Corazón amarillo", image: @image-url("../../stickers/1f49b.png") },
        { id: "1f9e1", name: "Corazón naranja", image: @image-url("../../stickers/1f9e1.png") },
        { id: "2728", name: "Brillos", image: @image-url("../../stickers/2728.png") },
        { id: "2b50", name: "Estrella", image: @image-url("../../stickers/2b50.png") },
        { id: "1f4a5", name: "Impacto", image: @image-url("../../stickers/1f4a5.png") },
        { id: "2705", name: "Correcto", image: @image-url("../../stickers/2705.png") },
        { id: "274c", name: "Error", image: @image-url("../../stickers/274c.png") },
        { id: "2753", name: "Pregunta", image: @image-url("../../stickers/2753.png") },
        { id: "2757", name: "Atención", image: @image-url("../../stickers/2757.png") },
        { id: "1f4ac", name: "Comentario", image: @image-url("../../stickers/1f4ac.png") },
        { id: "1f4a1", name: "Idea", image: @image-url("../../stickers/1f4a1.png") },
    ];
    property <[StickerData]> group4: [
        { id: "1f4f8", name: "Foto", image: @image-url("../../stickers/1f4f8.png") },
        { id: "1f3a5", name: "Vídeo", image: @image-url("../../stickers/1f3a5.png") },
        { id: "1f3a4", name: "Micrófono", image: @image-url("../../stickers/1f3a4.png") },
        { id: "1f3a7", name: "Auriculares", image: @image-url("../../stickers/1f3a7.png") },
        { id: "1f4f1", name: "Móvil", image: @image-url("../../stickers/1f4f1.png") },
        { id: "1f4bb", name: "Portátil", image: @image-url("../../stickers/1f4bb.png") },
        { id: "1f3ae", name: "Gaming", image: @image-url("../../stickers/1f3ae.png") },
        { id: "1f3b5", name: "Música", image: @image-url("../../stickers/1f3b5.png") },
        { id: "1f514", name: "Notificación", image: @image-url("../../stickers/1f514.png") },
        { id: "1f381", name: "Regalo", image: @image-url("../../stickers/1f381.png") },
        { id: "1f680", name: "Cohete", image: @image-url("../../stickers/1f680.png") },
        { id: "1f451", name: "Corona", image: @image-url("../../stickers/1f451.png") },
    ];
    property <[StickerData]> group5: [
        { id: "1f980", name: "Cangrejo", image: @image-url("../../stickers/1f980.png") },
        { id: "1f431", name: "Gato", image: @image-url("../../stickers/1f431.png") },
        { id: "1f436", name: "Perro", image: @image-url("../../stickers/1f436.png") },
        { id: "1f98b", name: "Mariposa", image: @image-url("../../stickers/1f98b.png") },
        { id: "1f308", name: "Arcoíris", image: @image-url("../../stickers/1f308.png") },
        { id: "2600", name: "Sol", image: @image-url("../../stickers/2600.png") },
        { id: "1f334", name: "Palmera", image: @image-url("../../stickers/1f334.png") },
        { id: "1f30d", name: "Mundo", image: @image-url("../../stickers/1f30d.png") },
        { id: "1f355", name: "Pizza", image: @image-url("../../stickers/1f355.png") },
        { id: "2615", name: "Café", image: @image-url("../../stickers/2615.png") },
        { id: "1f389", name: "Confeti", image: @image-url("../../stickers/1f389.png") },
        { id: "1f3c6", name: "Trofeo", image: @image-url("../../stickers/1f3c6.png") },
    ];
    property <[StickerData]> items: root.category == 1 ? root.group1 : root.category == 2 ? root.group2 : root.category == 3 ? root.group3 : root.category == 4 ? root.group4 : root.group5;
    property <int> cols: Math.max(1, Math.floor((root.width + 8px) / 96px));
    property <length> card-w: (root.width - (root.cols - 1) * 8px) / root.cols;
    property <length> card-h: root.card-w + 20px;
    height: Math.ceil(root.items.length / root.cols) * (root.card-h + 8px);
    for item[index] in root.items: Rectangle {
        x: Math.mod(index, root.cols) * (root.card-w + 8px);
        y: Math.floor(index / root.cols) * (root.card-h + 8px);
        width: root.card-w;
        height: root.card-h;
        border-radius: Theme.r;
        background: touch.has-hover ? Theme.field-hover : Theme.field;
        border-width: 1px;
        border-color: touch.has-hover ? Theme.accent : Theme.line;
        drag := DragArea {
            data: Payload.of("sticker:\{item.id}:\{item.name}");
            drag-image: item.image;
            allow-copy: true;
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.placed(item.id, item.name); }
                Image { x: 12px; y: 12px; width: parent.width - 24px; height: root.card-w - 24px; source: item.image; image-fit: contain; }
                Text { x: 4px; y: root.card-w; width: parent.width - 8px; height: 18px; text: item.name; color: Theme.fg-muted; font-size: Theme.fs-sm; horizontal-alignment: center; overflow: elide; }
            }
        }
    }
}
